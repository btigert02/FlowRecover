{
  "hosting": [
    {
      "site": "flowrecover",
      "public": ".",
      "ignore": ["firebase.json", "firestore.rules", "SETUP.md", "functions/**", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        },
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
        }
      ],
      "rewrites": [{ "source": "/api/stripe-webhook", "function": { "functionId": "stripeWebhook", "region": "asia-southeast1" } }]
    },
    {
      "site": "flowrecover-app",
      "public": ".redirect_stub",
      "redirects": [
        {
          "source": "/**",
          "destination": "https://flowrecover.web.app",
          "type": 301
        }
      ]
    }
  ],
  "firestore": { "rules": "firestore.rules" },
  "functions": { "source": "functions" }
}
