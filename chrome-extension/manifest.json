{
  "manifest_version": 3,
  "name": "FlowRecover: Focus Timer, Context Bookmark & Task Planner",
  "version": "1.0.0",
  "description": "Pause deep work without losing context. Save instant context bookmarks, run Pomodoro focus timers, and capture tasks from any tab.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowRecover — Focus & Context Recovery",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

