{
  "manifest_version": 3,
  "name": "FlowRecover: Adaptive Time Blocking, Pomodoro & Life Planner",
  "version": "1.1.0",
  "description": "The time-blocking planner built for people who get interrupted. Save 1-click context bookmarks, run Pomodoro timers & auto-reflow tasks.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowRecover — Adaptive Time Blocking & Pomodoro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
